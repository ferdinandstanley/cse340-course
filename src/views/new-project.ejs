<%- include('partials/header') %>

    <main class="container">
        <h1>Create New Service Project</h1>

        <% if (typeof errors !=='undefined' && errors.length> 0) { %>
            <div class="alert error">
                <ul>
                    <% errors.forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
            </div>
            <% } %>

        <form action="/new-project" method="POST">

            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" required>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" required>
            </div>

            <div class="form-group">
                <label for="date">Project Date</label>
                <input type="date" id="date" name="date" required>
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="">Select an Organization</option>

                    <% organizations.forEach(organization=> { %>
                        <option value="<%= organization.organization_id %>">
                            <%= organization.name %>
                        </option>
                        <% }) %>
                </select>
            </div>

            <button type="submit">Create Project</button>
        </form>

        <p>
            <a href="/projects">Cancel and Return to Projects</a>
        </p>
    </main>

    <%- include('partials/footer') %>
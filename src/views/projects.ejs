<%- include('partials/header', { title }) %>

    <main class="container">

        <section class="page-intro">
            <h1>
                <%= title %>
            </h1>

            <p>
                Discover upcoming opportunities to serve,
                volunteer, and make a difference.
            </p>
        </section>

        <section class="project-grid">

            <article class="project-card">
                <h2>Park Cleanup</h2>

                <p>
                    Join us to clean up local parks, remove litter,
                    and make our public spaces more beautiful.
                </p>

                <span class="project-category">Environmental</span>
            </article>

            <article class="project-card">
                <h2>Food Drive</h2>

                <p>
                    Help collect and distribute food to individuals
                    and families in need.
                </p>

                <span class="project-category">Community Service</span>
            </article>

            <article class="project-card">
                <h2>Community Tutoring</h2>

                <p>
                    Volunteer to tutor students in various subjects
                    and support educational development.
                </p>

                <span class="project-category">Educational</span>
            </article>

        </section>

    </main>

    <%- include('partials/footer') %>
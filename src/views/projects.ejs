<%- include('partials/header', { title }) %>

    <main class="container">

        <section class="page-intro">
            <h1>
                <%= title %>
            </h1>

            <div class="project-actions">
                <a href="/new-project" class="action-button edit-button">
                    + Create New Service Project
                </a>
            </div>

            <p>
                Discover upcoming opportunities to serve,
                volunteer, and make a difference.
            </p>
        </section>

        <section class="project-grid">

            <% if (projects.length===0) { %>

                <p>No service projects are currently available.</p>

                <% } else { %>

                    <% projects.forEach(project=> { %>

                        <article class="project-card">

                            <h2>
                                <a class="project-title-link" href="/project/<%= project.project_id %>">
                                    <%= project.title %>
                                </a>
                            </h2>

                            <p>
                                <%= project.description %>
                            </p>

                            <p>
                                <strong>Organization:</strong>
                                <a class="organization-link" href="/organization/<%= project.organization_id %>">
                                    <%= project.organization_name %>
                                </a>
                            </p>

                            <p>
                                <strong>Location:</strong>
                                <%= project.location %>
                            </p>

                            <p>
                                <strong>Date:</strong>
                                <%= new Date(project.date).toLocaleDateString( 'en-GB' , { day: 'numeric' ,
                                    month: 'long' , year: 'numeric' , timeZone: 'UTC' } ) %>
                            </p>

                        </article>

                        <% }); %>

                            <% } %>

        </section>

    </main>

    <%- include('partials/footer') %>
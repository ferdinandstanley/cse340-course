<%- include('partials/header', { title }) %>

    <main class="container home-page">

        <section class="hero">
            <div class="hero-content">
                <h1>
                    <%= title %>
                </h1>

                <h2>Welcome to the CSE 340 Service Network!</h2>

                <p>
                    Our mission is to promote service across the world
                    by connecting volunteers with meaningful service
                    opportunities in their communities.
                </p>

                <a href="/projects" class="btn-primary">
                    Explore Service Projects
                </a>
            </div>

            <div class="hero-image">
                <img class="main-logo" src="/images/cse340-service-network.png" alt="CSE 340 Service Network Logo">
            </div>
        </section>

    </main>

    <%- include('partials/footer') %>

<%- include('partials/header', { title }) %>

    <main class="container">
        <section class="page-intro">
            <h1>
                <%= title %>
            </h1>

            <p>
                Meet our partner organizations working to make
                a positive difference in communities.
            </p>
        </section>

        <section class="organization-grid">

            <% if (organizations.length===0) { %>

                <p>No organizations are currently available.</p>

                <% } else { %>

                    <% organizations.forEach(organization=> { %>

                        <article class="organization-card">

                            <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">

                            <h2>
                                <%= organization.name %>
                            </h2>

                            <p>
                                <%= organization.description %>
                            </p>

                            <p>
                                <strong>Email:</strong>
                                <a href="mailto:<%= organization.contact_email %>">
                                    <%= organization.contact_email %>
                                </a>
                            </p>

                        </article>

                        <% }); %>

                            <% } %>

        </section>
    </main>

    <%- include('partials/footer') %>
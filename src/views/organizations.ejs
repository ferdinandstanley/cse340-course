<%- include('partials/header', { title }) %>

    <main class="container">
        <section class="page-intro">
            <h1>
                <%= title %>
            </h1>

            <p>
                Meet our partner organizations working to make
                a positive difference in communities.
            </p>
        </section>

        <section class="organization-grid">

            <article class="organization-card">
                <img src="/images/brightfuture-logo.png" alt="BrightFuture Builders logo">

                <h2>BrightFuture Builders</h2>

                <p>
                    Supporting community development and creating
                    opportunities for a brighter future.
                </p>

                <p>
                    <strong>Email:</strong>
                    info@brightfuture.org
                </p>
            </article>

            <article class="organization-card">
                <img src="/images/greenharvest-logo.png" alt="GreenHarvest Growers logo">

                <h2>GreenHarvest Growers</h2>

                <p>
                    Promoting environmental sustainability,
                    agriculture, and greener communities.
                </p>

                <p>
                    <strong>Email:</strong>
                    contact@greenharvest.org
                </p>
            </article>

            <article class="organization-card">
                <img src="/images/unityserve-logo.png" alt="UnityServe Volunteers logo">

                <h2>UnityServe Volunteers</h2>

                <p>
                    Bringing people together through volunteerism
                    and meaningful community service.
                </p>

                <p>
                    <strong>Email:</strong>
                    hello@unityserve.org
                </p>
            </article>

        </section>
    </main>

    <%- include('partials/footer') %>
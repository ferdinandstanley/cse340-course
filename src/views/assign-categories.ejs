<%- include('partials/header') %>

    <main class="container">
        <h1>Assign Categories</h1>

        <h2>
            <%= project.title %>
        </h2>

        <p>Select the categories that apply to this project.</p>

        <form action="/assign-categories/<%= project.project_id %>" method="POST">
            <div class="form-group">
                <% categories.forEach(category=> { %>
                    <div class="checkbox-group">
                        <label>
                            <input type="checkbox" name="categoryIds" value="<%= category.category_id %>"
                                <%=assignedCategories.some( assigned=> assigned.category_id === category.category_id
                            ) ? 'checked' : '' %>
                            >
                            <%= category.name %>
                        </label>
                    </div>
                    <% }) %>
            </div>

            <button type="submit">Save Categories</button>
        </form>

        <p>
            <a href="/project/<%= project.project_id %>">
                Cancel and Return to Project
            </a>
        </p>
    </main>

    <%- include('partials/footer') %>
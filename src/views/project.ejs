<%- include('partials/header', { title }) %>

    <main class="container">
        <section class="page-intro">
            <h1>
                <%= project.title %>
            </h1>
            <p>Learn more about this community service project.</p>
        </section>

        <section class="project-details">
            <article class="project-card">
                <h2>Project Description</h2>
                <p>
                    <%= project.description %>
                </p>

                <p>
                    <strong>Location:</strong>
                    <%= project.location %>
                </p>

                <p>
                    <strong>Project Date:</strong>
                    <%= project.date.toLocaleDateString('en-GB', { day: 'numeric' , month: 'long' , year: 'numeric' ,
                        timeZone: 'UTC' }) %>
                </p>

                <p>
                    <strong>Organized by:</strong>
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </p>

                <div class="project-categories">
                    <strong>Project Categories:</strong>

                    <% if (categories && categories.length> 0) { %>
                        <div class="category-tags">
                            <% categories.forEach(category=> { %>
                                <a href="/category/<%= category.category_id %>" class="category-tag">
                                    <%= category.name %>
                                </a>
                                <% }); %>
                        </div>
                        <% } else { %>
                            <p>No categories assigned to this project.</p>
                            <% } %>
                </div>

            </article>
        </section>

        <div class="project-actions">
            <a class="action-button edit-button" href="/assign-categories/<%= project.project_id %>">
                Assign Categories
            </a>
        
            <a class="action-button edit-button" href="/edit-project/<%= project.project_id %>">
                Edit Project
            </a>
        
            <a class="action-button back-button" href="/projects">
                ← Back to Service Projects
            </a>
        </div>
    </main>

    <%- include('partials/footer') %>
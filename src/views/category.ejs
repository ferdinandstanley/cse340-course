<%- include('partials/header', { title }) %>

    <main class="container">
        <section class="page-intro">
            <h1>
                <%= category.name %>
            </h1>
            <p>Explore service projects under this category.</p>
        </section>

        <section class="category-projects">
            <h2>Projects in This Category</h2>

            <% if (projects && projects.length> 0) { %>
                <div class="project-grid">
                    <% projects.forEach(project=> { %>
                        <article class="project-card">
                            <h3>
                                <a href="/project/<%= project.project_id %>">
                                    <%= project.title %>
                                </a>
                            </h3>

                            <p>
                                <%= project.description %>
                            </p>

                            <p>
                                <strong>Location:</strong>
                                <%= project.location %>
                            </p>

                            <p>
                                <strong>Organization:</strong>
                                <a href="/organization/<%= project.organization_id %>">
                                    <%= project.organization_name %>
                                </a>
                            </p>

                            <p>
                                <strong>Date:</strong>
                                <%= project.date.toLocaleDateString('en-GB', { day: 'numeric' , month: 'long' ,
                                    year: 'numeric' , timeZone: 'UTC' }) %>
                            </p>
                        </article>
                        <% }); %>
                </div>
                <% } else { %>
                    <p>No projects are currently associated with this category.</p>
                    <% } %>
        </section>

        <p><a href="/categories">← Back to Categories</a></p>
    </main>

    <%- include('partials/footer') %>
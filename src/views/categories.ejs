<%- include('partials/header', { title }) %>

    <main class="container">
        <section class="page-intro">
            <h1>
                <%= title %>
            </h1>
            <p>
                Explore different ways to make a positive impact
                in our communities through service.
            </p>
        </section>

        <section class="category-grid">
            <article class="category-card">
                <h2>Environmental</h2>
                <p>
                    Participate in activities that protect the environment,
                    promote sustainability, and improve our surroundings.
                </p>
            </article>

            <article class="category-card">
                <h2>Educational</h2>
                <p>
                    Support learning opportunities, mentorship,
                    literacy, and educational development.
                </p>
            </article>

            <article class="category-card">
                <h2>Community Service</h2>
                <p>
                    Help communities through volunteering,
                    neighborhood improvement, and outreach programs.
                </p>
            </article>

            <article class="category-card">
                <h2>Health and Wellness</h2>
                <p>
                    Promote healthy living, wellness awareness,
                    and support for people in need.
                </p>
            </article>
        </section>
    </main>

    <%- include('partials/footer') %>
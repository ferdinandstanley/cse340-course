<%- include('partials/header', { title }) %>

    <main class="container">

        <section class="page-intro">

            <h1>
                <%= title %>
            </h1>

            <p>
                Explore different ways to make a positive impact
                in our communities through service.
            </p>

            <div class="project-actions">
                <a href="/new-category" class="action-button edit-button">
                    + Create New Category
                </a>
            </div>

        </section>

        <section class="category-grid">

            <% if (categories && categories.length> 0) { %>

                <% categories.forEach(category=> { %>

                    <article class="category-card">

                        <h2>
                            <a href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a>
                        </h2>

                        <div class="category-actions">
                            <a href="/edit-category/<%= category.category_id %>" class="action-button edit-button">
                                Edit Category
                            </a>
                        </div>

                    </article>

                    <% }); %>

                        <% } else { %>

                            <p>No categories are currently available.</p>

                            <% } %>

        </section>

    </main>

    <%- include('partials/footer') %>
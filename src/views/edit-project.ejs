<%- include('partials/header') %>

    <main class="container">
        <% if (typeof errors !=='undefined' && errors.length> 0) { %>
            <div class="alert error">
                <ul>
                    <% errors.forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
            </div>
            <% } %>

        <form action="/edit-project/<%= project.project_id %>" method="POST">

            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= project.title %>" required>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required><%= project.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= project.location %>" required>
            </div>

            <div class="form-group">
                <label for="date">Project Date</label>
                <input type="date" id="date" name="date"
                    value="<%= new Date(project.date).toISOString().split('T')[0] %>" required>
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <% organizations.forEach(organization=> { %>
                        <option value="<%= organization.organization_id %>"
                            <%=organization.organization_id===project.organization_id ? 'selected' : '' %>
                            >
                            <%= organization.name %>
                        </option>
                        <% }) %>
                </select>
            </div>

            <button type="submit">Update Project</button>
        </form>

        <p>
            <a href="/project/<%= project.project_id %>">
                Cancel and Return to Project
            </a>
        </p>
    </main>

    <%- include('partials/footer') %>